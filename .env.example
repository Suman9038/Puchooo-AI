# .env.example
# Copy this file to .env and fill in your own values

# API Keys
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>
HUGGINGFACEHUB_ACCESS_TOKEN=<YOUR_HUGGINGFACE_TOKEN>
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Local Database URL
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:<YOUR_DB_PASSWORD>@localhost:5432/puchoooAI
# Alembic requires %% to escape % in configparser
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:<YOUR_DB_PASSWORD>@localhost:5432/puchoooAI

# Qdrant Local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=Puchooo_AI
LOCAL_QDRANT_URL=http://localhost:6333
EMBEDDING_DIMENSION=768

# Redis Local
REDIS_HOST=localhost
REDIS_PORT=6379
LOCAL_REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=<YOUR_JWT_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email SMTP
VERIFICATION_URL=http://localhost:5173/verify-email?token={token}
MAIL_USERNAME=<YOUR_EMAIL>
MAIL_PASSWORD=<YOUR_EMAIL_PASSWORD>
MAIL_FROM=<YOUR_EMAIL>
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Puchooo_AI
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
