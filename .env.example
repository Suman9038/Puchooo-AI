# ==============================================================================
# Puchooo AI - Production VPS Environment Variables (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=puchoooAI
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_123@postgres:5432/puchoooAI
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_123@postgres:5432/puchoooAI

# ------------------------------------------------------------------------------
# 2. Redis Cache & Celery Task Queue
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
LOCAL_REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=Puchooo_AI
LOCAL_QDRANT_URL=http://qdrant:6333
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 4. LLM & Embeddings
# ------------------------------------------------------------------------------
# Environment: 'production' (VPS) or 'development' (Local)
# - VPS Fallback:       Groq -> Gemini -> OpenRouter -> Ollama
# - Local Dev Fallback:  Groq -> Ollama -> Gemini -> OpenRouter
# - Custom Fallback:     LLM_FALLBACK_CHAIN=groq,gemini,openrouter,ollama
APP_ENV=development
PRIMARY_LLM=groq
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-4B-GGUF:Q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Embeddings: FastEmbed (ONNX Runtime, Zero PyTorch, Disk Cached)
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
FASTEMBED_CACHE_PATH=.embeddings/.cache
EMBEDDING_THREADS=4

# ------------------------------------------------------------------------------
# 5. Cloud LLM API Keys (Optional Fallbacks)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=
HUGGINGFACEHUB_ACCESS_TOKEN=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 6. JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=puchooo_super_secure_jwt_secret_key_change_me_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 7. Email Verification (SMTP)
# ------------------------------------------------------------------------------
VERIFICATION_URL=http://localhost/verify-email?token={token}
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@puchooo.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Puchooo_AI
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ------------------------------------------------------------------------------
# 8. YouTube Transcript Proxy (Optional)
# ------------------------------------------------------------------------------
ENABLE_TRANSCRIPT_PROXY=False
FREE_PROXY_API=
